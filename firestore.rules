rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mukeshpuniya33@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User document and all subcollections (workers, attendance, settings, etc.)
    // Full read, write, create, update, delete permissions for signed-in users
    match /users/{userId} {
      allow read, write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Account Data Transfers between Email IDs (100% Reliable Cross-Account Recovery)
    match /transfers/{transferId} {
      allow read, write: if true;
    }

    // Global Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
